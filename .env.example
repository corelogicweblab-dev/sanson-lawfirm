# =============================================================================
# SANSON Legal OS — Environment Configuration
# =============================================================================

# App
APP_NAME=SANSON Legal OS
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
GIT_COMMIT_SHA=
FRONTEND_URL=
SENTRY_DSN=
ALERT_WEBHOOK_URL=

# See also: .env.development.example | .env.staging.example | .env.production.example

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxx.supabase.co:5432/postgres
DATABASE_SSL=true

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase (Backend — Admin SDK from Firebase Console > Service accounts)
FIREBASE_PROJECT_ID=sansonlawfirm
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase (Frontend — Client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBjKnYYKg5eOh-419mZWGZQjU2eDjVGGmk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sansonlawfirm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sansonlawfirm
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sansonlawfirm.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=76558169320
NEXT_PUBLIC_FIREBASE_APP_ID=1:76558169320:web:259dcf615a900b64c8855d
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-33Z7BDTPDY

# API
# Local backend: http://localhost:8100
# Production (Render): https://sanson-lawfirm.onrender.com
NEXT_PUBLIC_API_URL=https://sanson-lawfirm.onrender.com

# CORS (comma-separated) — Vercel + Firebase Hosting + local dev
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://sansonlawfirm.web.app,https://sansonlawfirm.firebaseapp.com,https://your-app.vercel.app

# Security (Phase 7)
RATE_LIMIT_PER_MINUTE=60
# Field-level encryption for sensitive columns (generate: python -c "import secrets; print(secrets.token_hex(32))")
FIELD_ENCRYPTION_KEY=

# OpenAI (Phase 3+ — AI Legal Assistant & Document Analysis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=30

# Cloudflare R2 (Phase 4 — Document Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sanson-legal-documents
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
DOCUMENT_MAX_SIZE_MB=25

# Qdrant Cloud (Phase 5 — Semantic Search)
QDRANT_URL=
QDRANT_API_KEY=

# Embeddings (Phase 5)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_CHUNK_SIZE=800
EMBEDDING_CHUNK_OVERLAP=120

# Supabase Realtime (Phase 6 — mobile clients)
# EXPO_PUBLIC_* set in apps/mobile/.env
