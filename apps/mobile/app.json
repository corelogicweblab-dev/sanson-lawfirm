{
  "expo": {
    "name": "SANSON Legal OS",
    "slug": "sanson-legal-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sansonlegal",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.sansonlaw.legalos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      },
      "package": "ph.sansonlaw.legalos"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "extra": {
      "router": { "origin": false }
    }
  }
}
