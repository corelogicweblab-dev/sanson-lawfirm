{
  "name": "sanson-legal-os",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@sanson/web",
    "dev:backend": "cd apps/backend && python -m uvicorn app.main:app --reload --port 8100",
    "dev:mobile": "npm run dev --workspace=@sanson/mobile",
    "build": "node scripts/render-build.js",
    "build:render": "bash apps/backend/build.sh",
    "build:local": "turbo run build",
    "start:prod": "bash apps/backend/render-start.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "node scripts/run-migration.js",
    "db:manifest": "node scripts/migrate-pipeline.js --manifest",
    "db:check": "node scripts/migrate-pipeline.js --check",
    "validate:env": "node scripts/validate-env.js",
    "validate:env:prod": "node scripts/validate-env.js --environment production --offline",
    "build:web": "node scripts/verify-web-env.js && npm run build --workspace=@sanson/web",
    "deploy:netlify": "npm run build:web",
    "deploy:hosting": "echo Use Netlify (GitHub main) — see docs/NETLIFY.md. Firebase Hosting is not used."
  },
  "devDependencies": {
    "firebase-tools": "^15.19.0",
    "prisma": "^6.19.3",
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
